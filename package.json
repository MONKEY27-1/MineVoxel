{
  "name": "minevoxel-devtools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Test/dev tooling only — the game itself (index.html, src/) stays a plain, bundler-free static site. This package.json exists purely to drive Playwright against a static file server for the polish-pass test harness.",
  "scripts": {
    "serve": "node tools/devserver.js",
    "smoke": "node tools/run-with-server.js tools/smoke.js",
    "perf": "node tools/run-with-server.js tools/perf.js",
    "soak": "node tools/run-with-server.js tools/soak.js",
    "test:gen": "node tools/run-with-server.js tools/test-gen.js",
    "test:save": "node tools/run-with-server.js tools/test-save.js",
    "test:dup": "node tools/run-with-server.js tools/test-dup.js",
    "test:save-fuzz": "node tools/run-with-server.js tools/test-save-fuzz.js",
    "test:edge": "node tools/run-with-server.js tools/test-edge.js",
    "test:mobs": "node tools/run-with-server.js tools/test-mobs.js",
    "test:feel": "node tools/run-with-server.js tools/test-feel.js",
    "test:visual": "node tools/run-with-server.js tools/test-visual.js",
    "test:audio": "node tools/run-with-server.js tools/test-audio.js"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  }
}
